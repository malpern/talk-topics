{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malpern.github.io/talk-topics/waka/protocol.schema.json",
  "title": "Waka pixel policy protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/action"
    }
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "frame",
        "player",
        "delay_ticks",
        "width",
        "height",
        "runs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "player": {
          "enum": [
            0,
            1
          ]
        },
        "delay_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "width": {
          "const": 224
        },
        "height": {
          "const": 288
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64512,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 64512
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777215
              }
            ],
            "items": false
          },
          "description": "Run counts must sum to 64512; the decoder checks this semantic constraint."
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "direction"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "direction": {
          "enum": [
            "keep",
            "up",
            "left",
            "down",
            "right"
          ]
        }
      }
    }
  }
}
